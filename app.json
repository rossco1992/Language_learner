{
  "expo": {
    "name": "Hola Mundo!",
    "slug": "hola-mundo",
    "version": "1.0.0",
    "scheme": "holamundo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C63FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.holamundo.spanishlearner"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C63FF"
      },
      "package": "com.holamundo.spanishlearner"
    },
    "plugins": []
  }
}
